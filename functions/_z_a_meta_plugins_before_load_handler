# Set the base and typically useful options.
builtin setopt local_options
if [[ $options[xtrace] == on ]]; then
  builtin emulate -L zsh -o xtrace
else
  builtin emulate -L zsh
fi
builtin setopt extended_glob warn_create_global typeset_silent no_short_loops rc_quotes no_auto_pushd

local type=$1 id=$2 id_as=$3 args=$4 ices=$5 hook=$6 subtype=$7

if (( $+ICE[debug] )) {
  # Enable the output from this annex
  integer ibshow_messages=1 ibdebug=1
}

# Apply the default ices first.
local -a ices
ices=( "${(@Q)${(@z)_z_a_meta_plugins_state[default-ices]}}" )
(( ${#ices} > 0 && ${#ices} % 2 == 0 )) && ICE=( "${(@kv)ICE}" "${ices[@]}" )
# Exclude IDs with slashes and also packages
[[ $id == */* ]] && local bad_id=1
[[ $id == *:* ]] && local bad_id2=1
[[ $ICE[teleid] == */* ]] && local bad_tele=1
(( $+ICE[pack] )) && local is_pack=1

if (( bad_id || bad_id2 || bad_tele || is_pack )) {
  if (( ibdebug )) {
    local -a msgs
      msgs=( ${bad_id:+the ID contains a slash} ${bad_id2:+the ID looks like a snippet ID}
             ${bad_tele:+"the {ice}teleid{meta}''{msg} ice contains a slash"}
             ${is_pack:+"the ID is a package ↔ {ice}pack{meta}''{msg} ice given"} )
      +zi-message "{annex}meta-plugins-annex{ehi}:{rst} Skipping the {id-as}ID{ehi}: {meta}$id{rst} ({p}reason(s){ehi}:{rst} ${(j:, :)msgs}{rst})"
  }
  return 0
}

integer ibshow_messages iberror_flag
local -a match mbegin mend reply
local MATCH REPLY
integer MBEGIN MEND
local -A tpe_map
tpe_map=( 0 plugin 1 snippet )
# Reset the communication fields.
ZI[annex-before-load:new-@]=""
ZI[annex-before-load:new-global-ices]=""
# Strip the ID from some possible accidental /-s.
id=${${id#@}%%(///|//|/)}
local meta_plugin_data=${(v)_z_a_meta_plugins_map[$id]}

if [[ -n $meta_plugin_data || $id == (z-shell+|sharkdp) ]] {
  if [[ $id == z-shell+ && -z $meta_plugin_data ]]; then
    builtin print -u2 -r -- 'meta-plugins: @z-shell+ is retired; load UI, session and logging tools explicitly. See the migration guide.'
  fi
  if [[ $id == annexes+ ]]; then
    builtin print -u2 -r -- 'meta-plugins: @annexes+ is deprecated and now loads only @annexes; load optional annexes explicitly.'
  fi
  if [[ $id == z-shell ]]; then
    builtin print -u2 -r -- 'meta-plugins: @z-shell is deprecated; use @zsh-users+fast and choose history search and Git formatting separately.'
  fi
  if [[ $id == sharkdp && -z $meta_plugin_data ]]; then
    builtin print -u2 -r -- 'meta-plugins: @sharkdp is retired; use @console-tools and choose hexyl, hyperfine or vivid explicitly.'
  fi
  # Count the recognized meta-plugins
  _z_a_meta_plugins_map[recon-count]=$(( _z_a_meta_plugins_map[recon-count] + 1 ))
  local -a plugin_array loaded_plugins not_existing on_demand_cand on_demand_skip
  plugin_array=( ${(s: :)meta_plugin_data} )
  loaded_plugins=( "${zsh_loaded_plugins[@]}" "${ZI_REGISTERED_PLUGINS[@]}" "${(@k)ZI_SNIPPETS}" )
  # Zi owns pending work. Unlike a private list of expanded IDs, its queues
  # stop suppressing retries when a failed installation has been processed.
  local pending
  local -a task_fields
  for pending in "${ZI_TASKS[@]}" "${ZI_RUN[@]}"; do
    task_fields=( "${(@Q)${(@z)pending}}" )
    (( $#task_fields >= 5 )) && loaded_plugins+=( "$task_fields[5]" )
  done
  # Provisioning is ready only after its ice handler has been registered.
  # Merely expanding @annexes must not suppress a retry after a failed load.
  local -A provisioners=(
    sbin z-shell/z-a-bin-gem-node
    dlink z-shell/z-a-readurl
    dl z-shell/z-a-patch-dl
    cargo z-shell/z-a-rust
  )
  local -a registered_ices
  local extension capability provider
  for extension in ${(s:|:)ZI_EXTS[ice-mods]} ${(s:|:)ZI_EXTS2[ice-mods]}; do
    registered_ices+=( "${${extension#<->-}//\'\'/}" )
  done
  for capability provider in "${(@kv)provisioners}"; do
    if (( ${registered_ices[(Ie)$capability]} )); then
      loaded_plugins+=( "$provider" )
    else
      loaded_plugins=( "${(@)loaded_plugins:#$provider}" )
    fi
  done
  local p
  # Detect if any plugins should be skipped on-demand, via skip''.
  on_demand_cand=( ${(@)${(@ps:\t:)${(@s: :)${(@s.;.)ICE[skip]}}}} )
  for p ( $on_demand_cand ) {
    integer idx1 count=1
    local pattern="(*/$p*|$p*|*$p|*-$p*|*$p-*)"
    while (( (idx1 = $plugin_array[(in:count:)$pattern]) != ${#plugin_array} + 1  )) {
      count+=1
      on_demand_skip+=( $plugin_array[idx1] )
    }
  }
  # Check only recipes selected by this group, before queuing any of them.
  # These are the four supported installers, not a general dependency resolver.
  local token other_highlighter
  for p in ${plugin_array:|on_demand_skip}; do
    if [[ $p == z-shell/zsh-eza && $TERM != dumb ]] && (( ! $+commands[eza] )); then
      builtin print -u2 -r -- 'meta-plugins: @console-style requires eza; load @console-tools or install system eza first.'
      ZI[annex-before-load:new-@]=$args
      return 3
    fi
    if [[ $p == eza-community/eza && $OSTYPE/$CPUTYPE != linux*/x86_64 ]] &&
      (( ! $+commands[eza] )); then
      builtin print -u2 -r -- 'meta-plugins: install eza with your platform package manager before loading @console-tools on this platform, or use skip eza.'
      ZI[annex-before-load:new-@]=$args
      return 3
    fi
    if [[ $p == fzf && ${loaded_plugins[(Ie)fzf-go]} -gt 0 ||
          $p == fzf-go && ${loaded_plugins[(Ie)fzf]} -gt 0 && ${loaded_plugins[(Ie)fzf-go]} -eq 0 ]]; then
      builtin print -u2 -r -- 'meta-plugins: choose either @fuzzy or @fuzzy-src; another fzf installation is already loaded.'
      ZI[annex-before-load:new-@]=$args
      return 3
    fi
    # Release recipes carry the resolved target triple; hexyl, hyperfine and
    # vivid additionally lack Linux ARM64 assets.
    if [[ ${_z_a_meta_plugins_config_map[$p]} == *unsupported-platform.tar.gz* ||
          $p == sharkdp/(hexyl|hyperfine|vivid) && $OSTYPE/$CPUTYPE == linux*/(aarch64|arm64) ]] &&
      (( ! $+commands[${${p:t}/ripgrep/rg}] )); then
      builtin print -u2 -r -- "meta-plugins: install ${${p:t}/ripgrep/rg} with your platform package manager before loading @$id on this platform."
      ZI[annex-before-load:new-@]=$args
      return 3
    fi
    other_highlighter=''
    if [[ $p == zsh-users/zsh-syntax-highlighting ]] &&
      (( ${loaded_plugins[(Ie)z-shell/F-Sy-H]} || $+functions[_fsh_zle_highlight] )); then
      other_highlighter=z-shell/F-Sy-H
    elif [[ $p == z-shell/F-Sy-H ]] &&
      (( ${loaded_plugins[(Ie)zsh-users/zsh-syntax-highlighting]} || $+functions[_zsh_highlight] )); then
      other_highlighter=zsh-users/zsh-syntax-highlighting
    fi
    if [[ -n $other_highlighter ]]; then
      builtin print -u2 -r -- "meta-plugins: @$id cannot load $p while $other_highlighter is active; choose one highlighter."
      ZI[annex-before-load:new-@]=$args
      return 3
    fi
    for token in ${(Q)${(z)_z_a_meta_plugins_config_map[$p]}}; do
      case $token in
        sbin*|fbin*|packbgn*) capability=sbin ;;
        dlink*|.readurl*) capability=dlink ;;
        dl*|patch*) capability=dl ;;
        cargo*|rustup*) capability=cargo ;;
        *) continue ;;
      esac
      if (( ! ${registered_ices[(Ie)$capability]} )); then
        builtin print -u2 -r -- "meta-plugins: @$id requires ${provisioners[$capability]} for $p; load that annex first."
        ZI[annex-before-load:new-@]=$args
        return 3
      fi
    done
  done
  # Check if any plugins are missing on the disk.
  for p ( ${plugin_array:|on_demand_skip} ) {
    if [[ -z $_z_a_meta_plugins_map[$p] ]] && ! .zi-get-object-path AUTO "$p"
    then
      ibshow_messages=1
      not_existing+=( $p )
    fi
  }
  # Debug message.
  if (( ibshow_messages )) {
    (($+functions[.zi-two-paths])) || builtin source "${ZI[BIN_DIR]}/lib/zsh/side.zsh"
    # Output a separating newline if the previous-processed plugin isn't a meta-plugin → to cluster the messages.
    [[ -z $_z_a_meta_plugins_map[${ZI[annex-exposed-processed-IDs]##* }] ]] && builtin print
    +zi-message -n "{hi}$_z_a_meta_plugins_map[recon-count]{rst} "
    +zi-message "{annex}meta-plugins-annex{ehi}:{rst} Loading{ehi}:{rst} \`{b}{meta}$id{rst}' consisting of{ehi}:{rst}"
    integer count=0
    local -a skipped
    for p ( $plugin_array ) {
      count+=1
      .zi-any-colorify-as-uspl2 "$p"
      [[ $p = $plugin_array[-1] ]] && local enotlast= || local enotlast=0
      REPLY=${REPLY//\//∕}
      integer idx1=0 idx3=0
      if (( (idx1 = $loaded_plugins[(I)$p]) && \
      ! $not_existing[(I)$p] || (idx3 = $on_demand_skip[(I)$p]) )) && \
      [[ $p != z-shell/null ]] && [[ $p != z-shell/0 ]] {
        idx3=$on_demand_skip[(I)$p]
        local idtxt="{dbg}${p//\//∕} "
        if (( idx1 && ! idx3 )) {
          skipped+=( $REPLY )
          idtxt+="{warn}already loaded{rst}"
        } else {
          idtxt+="{warn}skip{rst}"
        }
        REPLY=$idtxt
      }
      +zi-message -n " {meta}$count{rst}{msg}) $REPLY{msg}${enotlast:+,}"
    }
    +zi-message ".{rst}"
    if (( ibdebug && ${#skipped} )) {
      +zi-message -n "{hi}$_z_a_meta_plugins_map[recon-count]{rst} "
      +zi-message "{annex}meta-plugins-annex{ehi}:{rst} Skipping already loaded{ehi}:{rst} ${(j:, :)skipped}{rst}"
    }
  }
  # Pre-process each plugin retrieving the assigned, default ice-lists and preparing the above communication fields.
  for p ( $plugin_array ) {
    local ice_list_data=$_z_a_meta_plugins_config_map[$p]
    if (( ( $not_existing[(I)$p] || ! $loaded_plugins[(I)$p] ) && \
    ! $on_demand_skip[(I)$p] )) || [[ $p == z-shell/null ]] || [[ $p == z-shell/0 ]] {
      # The ↑z-shell/null↑ is a bogus exception, as this plugin will never be loaded under the direct name.
      ZI[annex-before-load:new-@]+="$ice_list_data @${(q)p} "
    }
  }
  ZI[annex-before-load:new-@]+=" $args"
  ZI[annex-before-load:new-@]=${ZI[annex-before-load:new-@]## ##}
  # An empty replacement means the group was recognised and nothing remains to
  # load, which is success. Members reach that state by more than one route:
  # already loaded, or filtered out by `skip''`, which drops a member at the
  # queue guard whether or not it was ever loaded. Zi reads an odd hook status
  # as an error, so this must be 2 rather than 1.
  #
  # It returned 1 to suppress Zi's "No plugin or snippet ID given" message,
  # which was a workaround for z-shell/zi#511: the dispatcher turned an empty
  # replacement into one blank argument and reported a missing ID. That is
  # fixed, so the workaround now causes the error it was written to avoid.
  integer retval_part=2
} else {
  integer retval_part=0
}
return $(( ${${ZI[annex-before-load:new-global-ices]:+4}:-0} + retval_part + iberror_flag ))
